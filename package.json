{
  "name": "pomodoro-timer",
  "version": "2.0.0",
  "description": "タスク管理と集中タイマーを備えたポモドーロタイマーアプリ",
  "main": "out/main.js",
  "author": "Ryo Ishii",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dev": "node scripts/build.mjs --watch",
    "postinstall": "node scripts/ensure-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test src/core/core.test.ts test/store.test.ts",
    "test:e2e": "node scripts/build.mjs && node --test --test-concurrency=1 test/e2e.test.ts",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "pack": "node scripts/build.mjs && electron-builder --dir",
    "dist": "node scripts/build.mjs && electron-builder",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac --x64 --arm64",
    "dist:win": "node scripts/build.mjs && electron-builder --win --x64",
    "dist:linux": "node scripts/build.mjs && electron-builder --linux --x64"
  },
  "build": {
    "appId": "com.pomodoroatelier.app",
    "productName": "Pomodoro Atelier",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "scripts/after-pack.js",
    "files": [
      "out/**/*",
      "!out/**/*.map",
      "assets/sounds/**/*",
      "build/icon.png"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.60.0",
    "preact": "^11.2.0",
    "typescript": "^7.0.2"
  }
}
